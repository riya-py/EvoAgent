# Copy this file to .env and adjust as needed

# App
APP_NAME=EvoAgent
ENV=development
LOG_LEVEL=INFO

# Ollama
OLLAMA_HOST=http://localhost:11434
OLLAMA_TIMEOUT_SECONDS=60
# Context window (tokens) allocated per generation. Judge calls read all
# 8 answers in one prompt and need room to respond in kind — too small
# and Ollama silently truncates the response instead of erroring.
OLLAMA_NUM_CTX=8192
# Max tokens the model may GENERATE in one response. Separate from
# num_ctx — some models default this low enough to truncate a full
# multi-item judge JSON array even with num_ctx raised.
OLLAMA_NUM_PREDICT=2048

# Database
DATABASE_PATH=./data/arena.db

# --- LLM provider ---
# "ollama" (default): local, free, but slow and inconsistent on CPU-only
# hardware. "groq": hosted API, free tier, much faster and more
# consistent — good if local inference keeps timing out or hanging.
# Get a free key at https://console.groq.com (API Keys in the sidebar).
LLM_PROVIDER=ollama
# GROQ_API_KEY=gsk_your_key_here
# GROQ_BASE_URL=https://api.groq.com/openai/v1
# GROQ_TIMEOUT_SECONDS=60
# GROQ_MAX_TOKENS=2048

# Free-tier Groq accounts cap requests-in-flight and tokens-per-minute,
# both much lower than the per-day limit. 8 agents (or 3 judges reading
# all 8 answers at once) firing concurrently can blow past TPM even
# though request count alone looks fine.
# GROQ_MAX_CONCURRENCY=3
# Spaces request STARTS this many seconds apart, independent of
# GROQ_MAX_CONCURRENCY — stops several agents firing in the same instant
# from landing all their tokens in one TPM window before a 429 can react.
# GROQ_MIN_INTERVAL_SECONDS=3.0
# How many times to retry a single call after a 429, honoring Groq's
# retry-after header (falls back to this many seconds if missing).
# GROQ_MAX_RETRIES=5
# GROQ_RETRY_FALLBACK_SECONDS=5.0

# --- Dev convenience (all optional, leave unset for normal behavior) ---
# Local/CPU-only hardware makes the default per-personality model
# assignment (Scientist->qwen, Engineer->llama, etc.) slow and prone to
# Ollama swapping models in and out of memory. These let you pin things
# to specific models instead, without touching any code. Works with
# either LLM_PROVIDER — just use model names that provider recognizes
# (e.g. "llama3.2:1b" for Ollama, "llama-3.3-70b-versatile" for Groq).

# Pins EVERY agent to one model, skipping family-based resolution.
# Small/fast models are great here for quick iteration.
# DEV_MODEL_OVERRIDE=llama3.2:1b

# Judges (and evolution) need to follow a strict JSON schema, which
# small models are unreliable at. Point them at something more capable
# than your agent model. Falls back to DEV_MODEL_OVERRIDE, then normal
# resolution, if left unset.
# DEV_JUDGE_MODEL_OVERRIDE=mistral:latest

# Run a smaller roster (e.g. 3) instead of all 8 personalities, for a
# faster feedback loop while testing.
# DEV_AGENT_LIMIT=3

# Judges normally run concurrently. On CPU-only Ollama that just splits
# limited throughput three ways; on Groq free tier it bursts 3 large
# judge prompts (each reading all 8 answers) into one TPM window and
# risks 429s. Set true to run judges one at a time instead.
# DEV_JUDGES_SEQUENTIAL=true
